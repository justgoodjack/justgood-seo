# --- Supabase (server only; never expose the service role key) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth for the dashboard (single owner for now) ---
DASHBOARD_PASSWORD=choose-a-long-passphrase
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to cron routes
CRON_SECRET=
# 32 random bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Gemini (Google AI Studio free key) ---
GEMINI_API_KEY=
# Optional: leave blank to auto-pick the newest available flash model
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# --- Cloudflare Workers AI (images). Optional: no images if unset ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- YouTube Data API (optional video embeds) ---
YOUTUBE_API_KEY=

# --- Google Search Console: service account JSON, base64 encoded ---
# base64 -w0 service-account.json ; then add the service account email as a user on each GSC property
GOOGLE_SERVICE_ACCOUNT_B64=
# Optional free stock photo fallback (pexels.com/api)
PEXELS_API_KEY=
